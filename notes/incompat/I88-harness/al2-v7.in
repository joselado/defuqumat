! I88 fix round: al2-metal.in with fermi-dirac degauss=0.05 at the default nbnd=7 (the verifier's v7).
 &control
    calculation='scf'
 /
 &system
    ibrav=0, celldm(1)=7.50,
    nat=2, ntyp=1,
    ecutwfc=15.0, nosym=.true., noinv=.true.,
    occupations='smearing', smearing='fermi-dirac', degauss=0.05
 /
 &electrons
    conv_thr = 1.0d-12
 /
CELL_PARAMETERS alat
  -0.50  0.00  0.50
   0.00  0.50  0.50
  -1.00  1.00  0.00
ATOMIC_SPECIES
 Al  26.98 Al.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Al  0.00  0.00  0.00
 Al -0.50  0.50  0.00
K_POINTS automatic
 4 4 2 0 0 0
