! I88 fix round: al2-metal.in with gaussian degauss=0.03, celldm 7.60 and a 3x3x2 grid (the verifier's v1).
 &control
    calculation='scf'
 /
 &system
    ibrav=0, celldm(1)=7.60,
    nat=2, ntyp=1,
    ecutwfc=15.0, nosym=.true., noinv=.true.,
    occupations='smearing', smearing='gaussian', degauss=0.03
 /
 &electrons
    conv_thr = 1.0d-12
 /
CELL_PARAMETERS alat
  -0.50  0.00  0.50
   0.00  0.50  0.50
  -1.00  1.00  0.00
ATOMIC_SPECIES
 Al  26.98 Al.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Al  0.00  0.00  0.00
 Al -0.50  0.50  0.00
K_POINTS automatic
 3 3 2 0 0 0
