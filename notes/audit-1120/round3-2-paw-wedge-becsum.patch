 # -- the variational second-order energy -------------------------------------
 
 
+def _split(raw, symmetrise):
+    """``symmetrise`` of ``raw``'s value, with ``raw``'s own tangent.
+
+    The value/derivative split of the screening term below, on a ``becsum``
+    pytree (``None`` for a species with no projectors).
+    """
+    frozen = jax.tree_util.tree_map(jax.lax.stop_gradient, raw)
+    averaged = symmetrise(frozen)
+    return jax.tree_util.tree_map(lambda s, r, f: s + (r - f), averaged, raw, frozen)
+
+
+def full_zone_becsum(group, moved, raw):
+    """The ground-state ``becsum`` a PAW wedge's one-centre terms are built from.
+
+    ``PAW_symmetrize`` on the value, and the raw wedge sum as the tangent. On a
+    wedge the raw sum is not the ground state's ``becsum`` (0.188 apart on
+    PAW silicon's three-point wedge), so ``D = onecenter(raw)`` is not the
+    ``D`` the states are eigenvectors of. The raw tangent is the same choice
+    the screening term makes for ``drho``. Returned unchanged when ``moved``
+    has no PAW species or ``group`` no average, so a norm-conserving, an
+    ultrasoft or a ``nosym`` run does not move.
+    """
+    if moved.paw is None or getattr(group, "_becsum_symmetry", None) is None:
+        return raw
+    out = _split(raw, group.finish_becsum)
+    if _INJECT is not None:
+        # EXPERIMENT: the full-zone tangent of becsum along the displacement,
+        # injected through a linear function of the positions that is zero at x0.
+        x0, stacks = _INJECT
+        dx = moved.system.structure.positions - x0
+        frozen = jax.tree_util.tree_map(jax.lax.stop_gradient, out)
+        out = tuple(None if f is None else f + jnp.einsum("ac,ac...->...", dx, t)
+                    for f, t in zip(frozen, stacks))
+    return out
+
+
+_INJECT = None
+
+
+def full_zone_becsum_responses(group, moved, per_axis):
+    """The three field responses of ``becsum``, full zone in value, raw in tangent.
+
+    ``PAW_dusymmetrize`` (:func:`~defuqumat.response.efield.
+    _symmetrize_becsum_response`) on the value. The one-centre screening term
+    is quadratic in them, so it takes the split the grid screening term takes.
+    """
+    if moved.paw is None or getattr(group, "_becsum_symmetry", None) is None:
+        return per_axis
+    from defuqumat.response.efield import _symmetrize_becsum_response
+
+    return _split(list(per_axis),
+                  lambda frozen: _symmetrize_becsum_response(group, frozen))
+
+
