+    def turn(vector, rotation, omega, ns_shape=None, ns_dtype=None):
+        """``metric(R drho, rotate_ns(dns), dtau)`` from ``metric(drho, dns, dtau)``, on the host.
+
+        Route C's turn of a residual (``turn_packed(shifted=False)`` in
+        :func:`run_scf`) written in this metric's layout, so that
+        :meth:`~defuqumat.scf.mixing.AndersonMixer.rotate_history` can keep a
+        history that carries fit vectors (AUDIT-2026-11-20b #3). Every weight
+        is diagonal in G and the same for the three magnetization components,
+        so the turn is ``R`` on those components of every coefficient, real and
+        imaginary parts alike, with no shift since a residual is a difference.
+        The density's block is ``[Re, Im] x [n, m_x, m_y, m_z] x ngm`` without a
+        layout (:func:`~defuqumat.scf.potential._as_reals`) and
+        ``[n, m_x, m_y, m_z] x ngms`` under one
+        (:meth:`~defuqumat.scf.mixing.SphereLayout.rho_ddot_vector`). The ``ns``
+        block, ``sqrt(U/2)`` per site times ``ns`` as ``[Re, Im]``, turns as
+        ``rotate_ns``, which acts on the spin indices within a site and so
+        commutes with the per-site weight. ``tau``'s block is left as
+        ``turn_packed`` leaves ``tau``.
+        """
+        if calculation.nspin_mag != 4:
+            raise ValueError(
+                f"a fit vector turns with the moments only at nspin_mag = 4, and "
+                f"this run has nspin_mag = {calculation.nspin_mag}")
+        vector = np.array(vector, copy=True)
+        rotation = np.asarray(rotation, dtype=vector.dtype)
+        if layout is None:
+            ngm = int(gvectors.ngm)
+            head = vector[:8 * ngm].reshape(2, 4, ngm)
+            head[:, 1:] = np.einsum("ij,ajg->aig", rotation, head[:, 1:])
+            offset = 8 * ngm
+        else:
+            ngms = int(layout.stored_shape[1])
+            head = vector[:4 * ngms].reshape(4, ngms)
+            head[1:] = rotation @ head[1:]
+            offset = 4 * ngms
+        if ns_shape is not None:
+            from defuqumat.scf.orientation import rotate_ns
+
+            size = int(np.prod(ns_shape))
+            block = np.empty(ns_shape, dtype=ns_dtype)
+            block.real = vector[offset:offset + size].reshape(ns_shape)
+            block.imag = vector[offset + size:offset + 2 * size].reshape(ns_shape)
+            turned = rotate_ns(block, omega)
+            vector[offset:offset + size] = turned.real.ravel()
+            vector[offset + size:offset + 2 * size] = turned.imag.ravel()
+        return vector
