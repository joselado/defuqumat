+@pytest.fixture(scope="module")
+def metric_pieces():
+    """The dense set and cell of two-atom silicon, and a stand-in calculation with a U.
+
+    ``_rho_ddot_metric`` reads the dense G-vectors, the cell, ``nspin_mag``
+    and, under a Hubbard term, the per-site ``U/2``; nothing else, so no
+    Hamiltonian is built. Two sites with different ``U`` show that the turn of
+    ``ns`` commutes with the per-site weight.
+    """
+    from types import SimpleNamespace
+    from pathlib import Path
+
+    from defuqumat.basis.builder import build_basis
+    from defuqumat.io.pwin import read_pw_input
+    from defuqumat.system import build_system
+
+    case = Path(__file__).resolve().parents[1] / "data" / "qe" / "si2-tb09.in"
+    system = build_system(read_pw_input(case))
+    dense = build_basis(system).dense
+    calculation = SimpleNamespace(
+        basis=SimpleNamespace(dense=dense), system=SimpleNamespace(cell=system.cell),
+        nspin_mag=4, is_hubbard=True,
+        hubbard_coefficients={"u_metric": np.array([0.15, 0.05])})
+    return calculation, dense
+
+
+@pytest.mark.parametrize("in_g", [False, True])
+def test_the_fit_vector_turns_as_the_residual_it_was_made_from(metric_pieces, in_g):
+    """AUDIT-2026-11-20b #3: ``metric.turn(F(r))`` is ``F`` of the turned residual.
+
+    ``F`` is ``rho_ddot``'s fit vector of a residual with a density, a spinor
+    ``ns`` on two sites and a ``tau``; the turn is Route C's on a residual, ``R``
+    on the magnetization, ``rotate_ns`` on ``ns`` and ``tau`` left alone, as
+    ``turn_packed(shifted=False)`` does. Both layouts: the whole dense set in
+    real space, and the smooth sphere of ``mixing_space = 'g'``.
+    """
+    from defuqumat.scf.driver import _rho_ddot_metric
+    from defuqumat.scf.mixing import SphereLayout
+
+    calculation, dense = metric_pieces
+    shape = (4,) + tuple(dense.grid)
+    layout = (SphereLayout(dense, int(dense.ngm), calculation.system.cell, shape)
+              if in_g else None)
+    metric = _rho_ddot_metric(calculation, layout)
+    rng = np.random.default_rng(31)
+    omega = np.array([0.4, 0.2, -0.9])
+    turn = rotation_matrix(omega)
+    drho = rng.normal(size=shape)
+    dns = rng.normal(size=(4, 2, 5, 5)) + 1j * rng.normal(size=(4, 2, 5, 5))
+    dtau = rng.normal(size=shape)
+
+    def density(field):
+        return layout.stored_of(field) if in_g else field
+
+    fit = metric(density(drho), dns, dtau)
+    expected = metric(density(np.asarray(rotate_texture(drho, turn))),
+                      rotate_ns(dns, omega), dtau)
+    got = metric.turn(fit, turn, omega, ns_shape=dns.shape, ns_dtype=dns.dtype)
+    scale = np.abs(expected).max()
+    np.testing.assert_allclose(got, expected, rtol=0, atol=1e-12 * scale)
+    assert np.abs(got - fit).max() > 1e-3 * scale
+    assert float(got @ got) == pytest.approx(float(fit @ fit), rel=1e-12)
+
+
+def test_a_history_with_fit_vectors_turns_instead_of_being_dropped(metric_pieces):
+    """AUDIT-2026-11-20b #3: under ``rho_ddot``'s fit a turn keeps the history.
+
+    ``rotate_history`` dropped every history that carried fit vectors, and
+    since P146 every Anderson run carries them, so Route C reset the mixer at
+    every turn. With the metric's turn handed in, the history keeps its length,
+    the cached Gram matrix is the Gram matrix of the turned fit vectors, and
+    the step is equivariant, ``mix(R a, R b) = R mix(a, b)``, as on the flat
+    fit. Without the turn the history is still dropped.
+    """
+    from defuqumat.scf.driver import _rho_ddot_metric
+
+    calculation, dense = metric_pieces
+    shape = (4,) + tuple(dense.grid)
+    metric = _rho_ddot_metric(calculation)
+    rng = np.random.default_rng(32)
+    omega = np.array([-0.3, 0.6, 0.25])
+    turn = rotation_matrix(omega)
+
+    def rotated(vector):
+        return np.asarray(rotate_texture(vector.reshape(shape), turn)).ravel()
+
+    def fit(rho_in, rho_out):
+        return metric((rho_out - rho_in).reshape(shape), None, None)
+
+    plain = get_mixer("anderson", beta=0.3, history=4)
+    turned = get_mixer("anderson", beta=0.3, history=4)
+    dropped = get_mixer("anderson", beta=0.3, history=4)
+    pairs = [(_field(rng, shape).ravel(), _field(rng, shape).ravel()) for _ in range(4)]
+    for rho_in, rho_out in pairs[:3]:
+        for mixer in (plain, turned, dropped):
+            mixer.mix(rho_in, rho_out, fit=fit(rho_in, rho_out))
+    turned.rotate_history(rotated, None, lambda f: metric.turn(f, turn, omega))
+    dropped.rotate_history(rotated)
+    assert len(turned._residuals) == len(turned._fits) == 3
+    assert len(dropped._residuals) == len(dropped._fits) == 0
+    fresh = np.array([[a @ b for b in turned._fits] for a in turned._fits])
+    np.testing.assert_allclose(turned._gram, fresh, rtol=1e-12)
+
+    rho_in, rho_out = pairs[3]
+    expected = rotated(plain.mix(rho_in, rho_out, fit=fit(rho_in, rho_out)))
+    a, b = rotated(rho_in), rotated(rho_out)
+    got = turned.mix(a, b, fit=fit(a, b))
+    np.testing.assert_allclose(got, expected, rtol=1e-12, atol=1e-12)
+
