-    """The hold written out on one channel along ``z``: the shell and ``w`` on ``rho``."""
+def _held_reference(v_raw, rho, z, sigma=None):
+    """The hold written out on one channel along ``z``, with no FFT.
+
+    The shell and ``w`` are on ``rho``. The tail value is the shell's mean
+    over the cell when ``sigma`` is ``None``, and otherwise its Gaussian
+    average about each point divided by the indicator's, both summed in real
+    space over the images along ``z`` (the field is uniform in the plane, so
+    the in-plane Gaussian integrates to one in both). Returns the held
+    potential and the indicator's average, to mask where the ratio is noise.
+    """
     from scipy.special import erf
 
     from defuqumat.xc.mgga import LMBJ_HOLD_WIDTH, LMBJ_RHO_HOLD
@@ -340,8 +348,63 @@ def _held_reference(v_raw, rho):
     weight = np.where(positive, 0.5 * (1.0 + erf(
         np.log(np.where(positive, rho, LMBJ_RHO_HOLD) / LMBJ_RHO_HOLD) / LMBJ_HOLD_WIDTH)), 0.0)
     shell = (rho > LMBJ_RHO_HOLD) & (rho < 10.0 * LMBJ_RHO_HOLD)
-    tail = v_raw[shell].mean()
-    return weight * v_raw + (1.0 - weight) * tail
+    if sigma is None:
+        tail = np.full_like(v_raw, v_raw[shell].mean())
+        indicator = np.full_like(v_raw, shell.mean())
+    else:
+        d = z[:, None] - z[None, :]
+        kernel = sum(np.exp(-0.5 * (d + m * _SHEET_LENGTH) ** 2 / sigma ** 2) for m in range(-3, 4))
+        kernel *= (z[1] - z[0]) / (np.sqrt(2.0 * np.pi) * sigma)
+        indicator = kernel @ shell.astype(float)
+        tail = (kernel @ np.where(shell, v_raw, 0.0)) / np.where(indicator > 0.0, indicator, 1.0)
+    return weight * v_raw + (1.0 - weight) * tail, indicator
+
+
+def test_each_face_of_a_sheet_is_held_at_its_own_tail(monkeypatch):
+    """The tail value is the shell's Gaussian average about each point (audit 2026-11-20 #9, #10).
+
+    A sheet whose upper face decays as ``exp(-1.2 z)`` and lower face as
+    ``exp(-2 z)``, the two faces of a slab that differ. With one cell mean
+    both vacua were held at the same value; with the user's local form,
+    ``avg[shell v] / avg[shell]`` with the kernel ``c(r)`` is built with, each
+    is held at its own face's tail. Checked against the same formula summed in
+    real space, with no FFT.
+    """
+    from defuqumat.xc.mgga import LMBJ_SIGMA
+
+    _, _, z = _sheet_grid()
+    n, dn = _sheet_profile(z, 0.6, 1.0)
+    channel = [(n, _sheet_tau(n, dn))]
+    held = _sheet_potential(channel)[0]
+    raw = _sheet_potential(channel, monkeypatch)[0]
+    expected, indicator = _held_reference(raw, n, z, LMBJ_SIGMA)
+    reach = indicator > 1e-8
+    assert reach.mean() > 0.9
+    assert np.abs(held - expected)[reach].max() < 1e-10
+    # where each face's tail first falls below 1e-7, two decades under the
+    # shell and w below 1e-3: two values, not one
+    deep = n < 1e-7
+    above = np.flatnonzero(deep & (z > 20.0))[0]
+    below = np.flatnonzero(deep & (z < 20.0))[-1]
+    assert abs(held[above] - held[below]) > 5e-3
+
+
+def test_at_infinite_width_the_tail_is_the_shell_mean(monkeypatch):
+    """With ``lmbj_sigma = 1000`` the Gaussian keeps only ``G = 0``: the cell mean.
+
+    The local tail at infinite width is the mean of the potential over the
+    shell, the form the hold had before audit 2026-11-20 #9 and #10.
+    """
+    from defuqumat.xc.functional import resolve_functional
+
+    _, _, z = _sheet_grid()
+    n, dn = _sheet_profile(z, 0.6, 1.0)
+    channel = [(n, _sheet_tau(n, dn))]
+    wide = resolve_functional(["PZ"], "lmbj").with_lmbj(sigma=1000.0)
+    held = _sheet_potential(channel, functional=wide)[0]
+    raw = _sheet_potential(channel, monkeypatch, functional=wide)[0]
+    expected, _ = _held_reference(raw, n, z)
+    assert np.abs(held - expected).max() < 1e-10
 
 
