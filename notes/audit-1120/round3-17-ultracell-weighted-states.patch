+def _weighted_states(occupations, smearing) -> int | None:
+    """How many leading states hold all the weight, or ``None`` to keep every one.
+
+    ``None`` under smearing, where the count follows the Fermi level and a new
+    count is a new compiled kernel, and when no trailing state is empty. The
+    count is the last state with a nonzero weight in any block at any ``k0``,
+    read on the host from the weights the density is about to use, so a state
+    the pass leaves out has a weight of exactly zero and the sum is unchanged.
+    """
+    if smearing:
+        return None
+    used = np.flatnonzero(np.any(np.asarray(occupations) != 0.0, axis=(0, 1)))
+    if used.size == 0 or int(used[-1]) + 1 >= np.shape(occupations)[-1]:
+        return None
+    return int(used[-1]) + 1
+
