diff --git a/tests/unit/test_scf_stragglers.py b/tests/unit/test_scf_stragglers.py
new file mode 100644
index 00000000..e33024ce
--- /dev/null
+++ b/tests/unit/test_scf_stragglers.py
@@ -0,0 +1,87 @@
+"""Inside an SCF, a ``cegterg`` call hands up to five unsettled bands on (audit 2026-11-20b #9).
+
+``c_bands.f90``'s ``test_exit_cond`` re-enters ``cegterg`` inside an SCF only
+while more than five bands are unconverged; with one to five it moves on, and
+the next SCF iteration corrects them. The loop here ran every call until each
+band settled or 100 steps passed. ``stragglers`` is the SCF's allowance: at the
+end of every 20 steps the solve stops when at most that many bands are left.
+
+The case is a solve from random vectors at ``ethr = 1e-13``, where every
+k-point of two-atom silicon takes 22 to 36 steps with 8 bands. With the
+allowance each k-point stops at step 20 or at its own convergence before it;
+with 0 the solve is the one it was, step for step.
+"""
+
+import numpy as np
+import pytest
+
+from defuqumat.io.pwin import parse_pw_input
+from defuqumat.pseudo import read_upf
+from defuqumat.scf.driver import Calculation
+from defuqumat.solvers.davidson import MAXTER, SCF_STRAGGLERS
+from defuqumat.system.builder import build_system
+
+pytestmark = pytest.mark.unit
+
+_SILICON = """
+&control
+  calculation = 'scf'
+/
+&system
+  ibrav = 2, celldm(1) = 10.2, nat = 2, ntyp = 1, ecutwfc = 12.0,
+  nosym = .true., noinv = .true.
+/
+&electrons
+/
+ATOMIC_SPECIES
+ Si 28.086 Si.pz-vbc.UPF
+ATOMIC_POSITIONS alat
+ Si 0.00 0.00 0.00
+ Si 0.25 0.25 0.25
+K_POINTS automatic
+ 2 2 2 0 0 0
+"""
+
+
+@pytest.fixture(scope="module")
+def solved(pseudo_dir):
+    system = build_system(parse_pw_input(_SILICON))
+    pseudos = tuple(read_upf(pseudo_dir / s.pseudo_file)
+                    for s in system.structure.species)
+    calculation = Calculation(system, pseudos)
+    hamiltonians = calculation.hamiltonian(
+        calculation.potential(calculation.starting_density()).v_scf)
+    out = {}
+    for allowance in (0, SCF_STRAGGLERS):
+        energies, _, steps, unsettled = calculation.diagonalize(
+            hamiltonians, 8, None, 1.0e-13, return_steps=True,
+            stragglers=allowance)
+        out[allowance] = (np.asarray(energies), np.asarray(steps).ravel(),
+                          np.asarray(unsettled).ravel())
+    return out
+
+
+def test_without_an_allowance_every_band_settles(solved):
+    _, steps, unsettled = solved[0]
+    assert (unsettled == 0).all()
+    assert (steps > MAXTER).any(), steps
+
+
+def test_an_scf_call_stops_at_the_end_of_a_window_with_few_stragglers(solved):
+    _, steps, unsettled = solved[SCF_STRAGGLERS]
+    # Stopped at the first window end with at most five unsettled, or settled.
+    assert (steps <= MAXTER).all(), steps
+    assert (unsettled <= SCF_STRAGGLERS).all(), unsettled
+    # Some k-points handed bands on, and each of them would have gone on.
+    handed = unsettled > 0
+    assert handed.any(), (steps, unsettled)
+    assert (steps[handed] == MAXTER).all()
+    assert (solved[0][1][handed] > MAXTER).all()
+
+
+def test_the_settled_bands_agree(solved):
+    """The bands both solves settled agree to the threshold's scale."""
+    full, _, _ = solved[0]
+    cut, _, unsettled = solved[SCF_STRAGGLERS]
+    # The lowest four bands are occupied in silicon and are settled first.
+    assert np.max(np.abs(cut[..., :4] - full[..., :4])) < 1e-8
