+def test_the_kubler_sphere_potential_is_the_derivative_of_its_energy(oxygen_paw):
+    """``'kubler'`` on the sphere, with ``m-hat`` varying over it (AUDIT-2026-11-20b #11).
+
+    The rotated channels run through ``|m|``, which is not band-limited where the
+    direction varies or ``m`` has a node. QE evaluates the functional on the
+    channels cut to ``nlm`` multipoles (``compute_rho_spin_lm``, then
+    ``PAW_lm2rad``), and the potential assembled from the projection is the
+    derivative of that energy only. On this ``becsum`` the magnetization rows
+    of ``ddd`` missed ``jax.grad`` of the energy by 1.5e-2 of their largest
+    entry on the uncut channels, and miss it by 3.7e-4 on the cut ones; the
+    whole ``ddd`` by 5.6e-4 and 5.3e-5, where the collinear sphere reads 5.8e-5.
+    """
+    from defuqumat.paw.onecenter import onecenter_species
+
+    paw, _, charge, moment, _ = oxygen_paw
+    transverse = np.stack([moment, 0.5 * np.roll(moment, 1, axis=0) + 0.5 * np.roll(moment, 1, axis=0).T,
+                           0.3 * charge])
+    becsum = jnp.asarray(np.concatenate([charge[None], transverse]))
+    _, ddd = onecenter_species(paw, becsum, axis=None, noncollinear_gga="kubler")
+    grad = np.asarray(jax.grad(
+        lambda b: onecenter_species(paw, b, axis=None, noncollinear_gga="kubler")[0])(becsum))
+    grad = 0.5 * (grad + np.swapaxes(grad, 1, 2))
+    ddd = np.asarray(ddd)
+    assert np.abs(grad[1:] - ddd[1:]).max() < 2.0e-3 * np.abs(ddd[1:]).max()
+    assert np.abs(grad - ddd).max() < 2.0e-4 * np.abs(ddd).max()
