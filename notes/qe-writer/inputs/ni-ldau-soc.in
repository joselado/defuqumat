&control
      calculation = 'scf', pseudo_dir='../../../pseudo', outdir='./out'
   /
   &system
      ibrav = 2
      celldm(1) = 6.65
      nat = 1
      ntyp = 1
      ecutwfc = 30.0
      ecutrho = 240.0
      occupations = 'smearing'
      smearing = 'mv'
      degauss = 0.02
      noncolin = .true., lspinorb = .true.
      starting_magnetization(1) = 0.5
      angle1(1) = 60.0
      angle2(1) = 30.0
   /
   &electrons
      conv_thr = 1.d-10
      mixing_beta = 0.3
      electron_maxstep = 200
   /
   ATOMIC_SPECIES
   Ni 58.6934 Ni.rel-pbe-spn-rrkjus_psl.1.0.0.UPF
   ATOMIC_POSITIONS crystal
   Ni  0.00  0.00  0.00
   K_POINTS automatic
   3 3 3 0 0 0
   HUBBARD atomic
   U   Ni-3d 4.0
