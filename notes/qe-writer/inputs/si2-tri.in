 &control
    calculation='scf', pseudo_dir='../../../pseudo', outdir='./out'
 /
 &system
    ibrav=0, nat=2, ntyp=1, ecutwfc=14.0, nosym=.true.,
    occupations='smearing', smearing='gaussian', degauss=0.02
 /
 &electrons
    conv_thr = 1.0d-10
 /
CELL_PARAMETERS bohr
  7.10  0.30  0.20
  0.90  6.80 -0.40
  0.50  1.10  7.60
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS crystal
 Si 0.00 0.00 0.00
 Si 0.27 0.24 0.29
K_POINTS automatic
 2 2 2 0 0 0
