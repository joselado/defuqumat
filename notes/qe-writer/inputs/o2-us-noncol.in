 &control
    calculation='scf', pseudo_dir='../../../pseudo', outdir='./out'
 /
 &system
    ibrav=1, celldm(1)=7.0, nat=2, ntyp=1, ecutwfc=25.0, ecutrho=200.0,
    occupations='smearing', smearing='gaussian', degauss=0.01, nbnd=16,
    noncolin=.true., starting_magnetization(1)=0.5, angle1(1)=60.0, angle2(1)=30.0
 /
 &electrons
    mixing_beta=0.3, conv_thr=1.0d-10
 /
ATOMIC_SPECIES
 O  15.99994  O.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS (bohr)
 O 0.00 0.00 0.00
 O 0.00 0.00 2.30
K_POINTS tpiba
 1
 0.0 0.0 0.0 1.0
