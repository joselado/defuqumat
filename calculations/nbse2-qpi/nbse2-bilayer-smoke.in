! A reduced-cost copy of nbse2-bilayer.in for a smoke run of the driver.
 &control
    calculation = 'scf'
    prefix = 'nbse2-bilayer-smoke'
 /
 &system
    ibrav = 4, celldm(1) = 6.5044373210, celldm(3) = 7.0525857060,
    nat = 6, ntyp = 2,
    ecutwfc = 30.0,
    occupations = 'smearing', smearing = 'fermi-dirac', degauss = 0.002,
    nbnd = 32,
 /
 &electrons
    conv_thr = 1.0d-6
 /
