! Simple cubic hydrogen with a Hubbard U on the 1s shell -- the same cell
! and the same U (4 eV) as the Elk run in this directory, so the Elk DFT+U
! ground state can seed this one. Otherwise identical to ../h_sc/scf.in.
&CONTROL
  calculation = 'scf'
/
&SYSTEM
  ibrav = 1
  celldm(1) = 3.0
  nat = 1
  ntyp = 1
  ecutwfc = 40.0
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-10
/
ATOMIC_SPECIES
  H  1.008  H.pz-vbc.UPF
ATOMIC_POSITIONS crystal
  H 0.0 0.0 0.0
K_POINTS automatic
  4 4 4 0 0 0
HUBBARD {atomic}
  U H-1s 4.0
