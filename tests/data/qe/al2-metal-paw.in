! `al2-metal.in` with the PAW dataset `Al.pbe-n-kjpaw_psl.1.0.0.UPF`: the same doubled fcc
! cell, k-grid, `nosym` and smearing, so that the `Gamma`-point dynamical matrix
! of a metal with a moving overlap `S` (notes/incompat/I86.md) has a `ph.x`
! reference on a cell whose norm-conserving twin is already validated.
!
! `ecutwfc = 15` as in `al2-metal.in` and `ecutrho = 120` (8 x): a basis this
! small is not converged, and it does not have to be, since the comparison is
! with `ph.x` on the same input (`reference.out.ph-al2-metal-paw`, generated by
! `pw.x -in al2-metal-paw.in && ph.x -in al2-metal.ph.in` with the prefix
! renamed).
 &control
    calculation='scf'
 /
 &system
    ibrav=0, celldm(1)=7.50,
    nat=2, ntyp=1,
    ecutwfc=15.0, ecutrho=120.0, nosym=.true., noinv=.true.,
    occupations='smearing', smearing='marzari-vanderbilt', degauss=0.05
 /
 &electrons
    conv_thr = 1.0d-12
 /
CELL_PARAMETERS alat
  -0.50  0.00  0.50
   0.00  0.50  0.50
  -1.00  1.00  0.00
ATOMIC_SPECIES
 Al  26.98 Al.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS (alat)
 Al  0.00  0.00  0.00
 Al -0.50  0.50  0.00
K_POINTS automatic
 4 4 2 0 0 0
