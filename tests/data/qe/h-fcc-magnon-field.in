! h-fcc-magnon.in in a uniform field along the moment, B_field(3) = 0.01 Ry, and
! with degauss = 0.05 in place of 0.01: the Larmor case of the transverse spin
! susceptibility (notes/incompat/I58.md).
!
! The field enters the potential as -B on the up channel (E = -int B.m), so a
! majority-up moment is parallel to it and the uniform precession sits at the
! Zeeman energy 2 B = 0.02 Ry rather than at zero.
!
! The broadening is wider on purpose. At degauss = 0.01 no eigenvalue of the
! 4x4x4 mesh lies within a few degauss of the Fermi level, so the moment is
! pinned at 34/64 = 0.53125 and a field only shifts the two channels rigidly
! (up by -B, down by +B; measured at B = 0.002 and 0.02, the moment moved by
! 2e-6 and not at all): the field run is then the zero-field run relabelled,
! and the Larmor check tests the sign and nothing more. At 0.05 the cell is a
! metal on this mesh and the moment answers the field.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 6.5,
    nat = 1, ntyp = 1,
    ecutwfc = 25.0,
    occupations = 'smearing', smearing = 'gaussian', degauss = 0.05,
    nspin = 2
    nosym = .true., noinv = .true.
    starting_magnetization(1) = 0.9
    B_field(3) = 0.01
    nbnd = 8
 /
 &electrons
    mixing_beta = 0.3
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 H  1.008  H.pz-vbc.UPF
ATOMIC_POSITIONS (crystal)
 H 0.0 0.0 0.0
K_POINTS {automatic}
 4 4 4 0 0 0
