! The ground state of `alas-mag-berry.in`: AlAs at nspin = 2 with
! tot_magnetization = 2, on `alas-raman.in`'s 4x4x4 grid. Run by pw.x before
! the lberry input beside it, which reads this run's charge density.
 &control
    calculation = 'scf'
    prefix = 'alasmag'
 /
 &system
    ibrav = 2, celldm(1) = 10.575, nat = 2, ntyp = 2,
    ecutwfc = 10.0
    nosym = .true.
    noinv = .true.
    nspin = 2
    starting_magnetization(1) = 0.5
    tot_magnetization = 2
    nbnd = 8
 /
 &electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
 /
ATOMIC_SPECIES
 Al  26.98  Al.pz-vbc.UPF
 As  74.92  As.pz-bhs.UPF
ATOMIC_POSITIONS (alat)
 Al 0.00 0.00 0.00
 As 0.25 0.25 0.25
K_POINTS (automatic)
 4 4 4 0 0 0
