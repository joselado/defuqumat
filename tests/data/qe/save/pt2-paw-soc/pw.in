 &control
    calculation='scf', pseudo_dir='../../../pseudo', outdir='./out'
 /
 &system
    ibrav=6, celldm(1)=5.24, celldm(3)=1.41421356, nat=2, ntyp=1,
    ecutwfc=25.0, ecutrho=200.0,
    occupations='smearing', smearing='mv', degauss=0.02,
    noncolin=.true., lspinorb=.true.
 /
