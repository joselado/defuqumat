! I85: lelfield on a magnetized spinor and on a spin spiral. The hydrogen chain of
! P19 at fixed occupations (gapped: 0.156 Ry, 2.12 eV in pw.x), the field along x
! (gdir = 1) on strings of 3 points. The spiral of h-chain-spiral.in at q = b3/4:
! twelve k-points, kz = 0, 1/4, 1/2, 3/4, which fold onto the supercell's three.
 &control
    calculation = 'scf', lelfield = .true., gdir = 1, nppstr = 3, nberrycyc = 3
 /
 &system
    ibrav = 6, celldm(1) = 12.0, celldm(3) = 0.41666666666667,
    nat = 1, ntyp = 1,
    ecutwfc = 25.0,
    occupations = 'fixed'
    noncolin = .true.
    nosym = .true.
    starting_magnetization(1) = 0.6
    angle1(1) = 90.0
    spiral_q(1) = 0.0, spiral_q(2) = 0.0, spiral_q(3) = 0.25
    nbnd = 4
 /
 &electrons
    mixing_beta = 0.3
    conv_thr = 1.0d-11, efield = 0.001
 /
ATOMIC_SPECIES
 H  1.008  H.pz-vbc.UPF
ATOMIC_POSITIONS (crystal)
 H 0.0 0.0 0.0
K_POINTS crystal
12
 0.000000000000 0.0 0.000000000000 1
 0.333333333333 0.0 0.000000000000 1
 0.666666666667 0.0 0.000000000000 1
 0.000000000000 0.0 0.250000000000 1
 0.333333333333 0.0 0.250000000000 1
 0.666666666667 0.0 0.250000000000 1
 0.000000000000 0.0 0.500000000000 1
 0.333333333333 0.0 0.500000000000 1
 0.666666666667 0.0 0.500000000000 1
 0.000000000000 0.0 0.750000000000 1
