! Diamond silicon, LDA, norm-conserving, on the unshifted 4x4x4 mesh reduced
! with the point group. This mesh contains Gamma, where the gap is smallest,
! so the dielectric constant of this run is far from converged.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.20, nat = 2, ntyp = 1,
    ecutwfc = 18.0
 /
 &electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS (automatic)
 4 4 4 0 0 0
