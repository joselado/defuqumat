! Silicon with the second atom moved 0.02 alat along x, away from its site.
! The atoms feel a force back towards (1/4, 1/4, 1/4), and a relaxation
! (calculation = 'relax') brings them there.
 &control
    calculation = 'relax'
    tprnfor = .true.
 /
 &system
    ibrav=2, celldm(1)=10.20, nat=2, ntyp=1,
    ecutwfc=12.0
 /
 &electrons
    conv_thr = 1.0d-10
 /
 &ions
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.27 0.25 0.25
K_POINTS (automatic)
 4 4 4 0 0 0
