! AlAs, zincblende. The Berry-phase polarization along the third reciprocal
! lattice vector (lberry, gdir = 3), on strings of nppstr = 6 k-points.
! nppstr counts the last point, which is the first one shifted by b3.
 &control
    calculation = 'nscf'
    lberry = .true.
    gdir = 3
    nppstr = 6
    prefix = 'alas'
 /
 &system
    ibrav = 2, celldm(1) = 10.575, nat = 2, ntyp = 2,
    ecutwfc = 10.0
    nosym = .true.
    noinv = .true.
 /
 &electrons
    conv_thr = 1.0d-12
 /
ATOMIC_SPECIES
 Al  26.98  Al.pz-vbc.UPF
 As  74.92  As.pz-bhs.UPF
ATOMIC_POSITIONS (alat)
 Al 0.00 0.00 0.00
 As 0.25 0.25 0.25
K_POINTS (automatic)
 2 2 6 0 0 0
