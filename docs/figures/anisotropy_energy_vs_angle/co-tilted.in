! The tetragonal cobalt of co.in, self-consistent with spin-orbit coupling,
! with the moment started 45 degrees away from the c axis (angle1).
&control
   calculation = 'scf'
/
&system
   ibrav = 6, celldm(1) = 4.60, celldm(3) = 1.30, nat = 1, ntyp = 1,
   noncolin = .true., lspinorb = .true., nosym = .true.,
   ecutwfc = 20.0, ecutrho = 160.0,
   occupations = 'smearing', smearing = 'mv', degauss = 0.02,
   starting_magnetization(1) = 0.6,
   angle1(1) = 45.0, angle2(1) = 0.0,
/
&electrons
   conv_thr = 1.0e-10
   mixing_beta = 0.3
/
ATOMIC_SPECIES
Co 58.933 Co.rel-pbe-nd-rrkjus.UPF
ATOMIC_POSITIONS crystal
Co 0.0 0.0 0.0
K_POINTS automatic
3 3 2 0 0 0
