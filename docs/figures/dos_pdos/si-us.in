! Silicon, LDA, ultrasoft, on an 8x8x8 grid with four empty bands.
! The input of the figure "dos_pdos".
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.20, nat = 2, ntyp = 1,
    ecutwfc = 20.0, ecutrho = 160.0,
    nbnd = 8
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-n-rrkjus_psl.0.1.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS {automatic}
 8 8 8 0 0 0
