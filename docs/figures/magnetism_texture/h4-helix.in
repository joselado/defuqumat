! Four hydrogen atoms in a chain along z, 5 bohr apart, with a noncollinear
! moment on each. STARTING_MOMENTS gives one starting moment per atom, each
! turned by 90 degrees from the one before, in the plane across the chain.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 6, celldm(1) = 12.0, celldm(3) = 1.66666666666667,
    nat = 4, ntyp = 1,
    ecutwfc = 25.0,
    occupations = 'smearing', smearing = 'gaussian', degauss = 0.10
    noncolin = .true.
    starting_magnetization(1) = 0.6
    nbnd = 24
 /
 &electrons
    mixing_beta = 0.3
    conv_thr = 1.0d-8
 /
ATOMIC_SPECIES
 H  1.008  H.pz-vbc.UPF
ATOMIC_POSITIONS (crystal)
 H 0.0 0.0 0.00
 H 0.0 0.0 0.25
 H 0.0 0.0 0.50
 H 0.0 0.0 0.75
K_POINTS {automatic}
 1 1 4 0 0 0
STARTING_MOMENTS
  0.6000000000  0.0000000000  0.0000000000
  0.0000000000  0.6000000000  0.0000000000
 -0.6000000000  0.0000000000  0.0000000000
  0.0000000000 -0.6000000000  0.0000000000
