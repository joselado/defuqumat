! AlAs in the zincblende structure, LDA, norm-conserving. It has time-reversal
! symmetry but no inversion centre, so its Berry curvature is not zero at each k.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.575, nat = 2, ntyp = 2,
    ecutwfc = 10.0
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Al  26.98  Al.pz-vbc.UPF
 As  74.92  As.pz-bhs.UPF
ATOMIC_POSITIONS (alat)
 Al 0.00 0.00 0.00
 As 0.25 0.25 0.25
K_POINTS (automatic)
 4 4 4 0 0 0
