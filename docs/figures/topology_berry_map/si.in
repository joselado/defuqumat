! Silicon in the diamond structure, LDA, norm-conserving. It has inversion and
! time reversal, so its Berry curvature is zero at every k.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.20, nat = 2, ntyp = 1,
    ecutwfc = 16.0
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS (automatic)
 4 4 4 0 0 0
