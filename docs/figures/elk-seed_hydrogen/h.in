! Simple cubic hydrogen, one atom at the origin, a = 3.0 bohr.
! This is the same cell as the Elk run in elk/, so the Elk density
! can be the starting density of this run.
&CONTROL
  calculation = 'scf'
/
&SYSTEM
  ibrav = 1
  celldm(1) = 3.0
  nat = 1
  ntyp = 1
  ecutwfc = 40.0
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-10
/
ATOMIC_SPECIES
  H  1.008  H.pz-vbc.UPF
ATOMIC_POSITIONS crystal
  H 0.0 0.0 0.0
K_POINTS automatic
  4 4 4 0 0 0
