! Zincblende AlAs with spin-orbit coupling, PBE, ultrasoft, in a magnetic field
! B_field(3) along z. The small starting_magnetization along z is needed, so that
! the run carries a magnetization vector for the field to act on.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.6134, nat = 2, ntyp = 2,
    ecutwfc = 25.0, ecutrho = 200.0,
    noncolin = .true., lspinorb = .true.,
    nosym = .true., noinv = .true.,
    starting_magnetization(1) = 0.01, angle1(1) = 0.0,
    starting_magnetization(2) = 0.01, angle1(2) = 0.0,
    B_field(3) = 0.05
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.7
 /
ATOMIC_SPECIES
 Al 26.98 Al.rel-pbe-n-rrkjus_psl.1.0.0.UPF
 As 74.92 As.rel-pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
 Al 0.00 0.00 0.00
 As 0.25 0.25 0.25
K_POINTS (automatic)
 2 2 2 0 0 0
