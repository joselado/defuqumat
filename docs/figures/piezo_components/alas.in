! Zincblende AlAs, LDA, norm-conserving: the input of the figure "piezo_components".
! The k-mesh is unshifted, so the symmetry of the crystal reduces it to a wedge,
! and the response on that wedge is the same as on the full grid.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.575, nat = 2, ntyp = 2,
    ecutwfc = 10.0
 /
 &electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
 /
ATOMIC_SPECIES
 Al  26.98  Al.pz-vbc.UPF
 As  74.92  As.pz-bhs.UPF
ATOMIC_POSITIONS (alat)
 Al 0.00 0.00 0.00
 As 0.25 0.25 0.25
K_POINTS (automatic)
 4 4 4 0 0 0
