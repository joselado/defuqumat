! A chain of hydrogen atoms along z, 5 bohr apart, one atom per cell, with a
! flat spin spiral of wavevector spiral_q (crystal units of b). The moment
! starts in the plane across the chain (angle1 = 90).
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 6, celldm(1) = 12.0, celldm(3) = 0.41666666666667,
    nat = 1, ntyp = 1,
    ecutwfc = 25.0,
    occupations = 'smearing', smearing = 'gaussian', degauss = 0.10
    noncolin = .true.
    nosym = .true.
    starting_magnetization(1) = 0.6
    angle1(1) = 90.0
    spiral_q(1) = 0.0, spiral_q(2) = 0.0, spiral_q(3) = 0.25
    nbnd = 6
 /
 &electrons
    mixing_beta = 0.3
    conv_thr = 1.0d-11
 /
ATOMIC_SPECIES
 H  1.008  H.pz-vbc.UPF
ATOMIC_POSITIONS (crystal)
 H 0.0 0.0 0.0
K_POINTS {automatic}
 1 1 4 0 0 0
