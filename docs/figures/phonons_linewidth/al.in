! fcc aluminium, norm-conserving LDA, a metal with Marzari-Vanderbilt smearing.
! The electron-phonon coupling at q needs the whole k-mesh, so the symmetry is
! off (nosym, noinv) and the 8x8x8 mesh is unshifted.
 &control
    calculation='scf'
 /
 &system
    ibrav=2, celldm(1)=7.5, nat=1, ntyp=1,
    ecutwfc=15.0, nosym=.true., noinv=.true.,
    occupations='smearing', smearing='marzari-vanderbilt', degauss=0.05
 /
 &electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
 /
ATOMIC_SPECIES
 Al  26.98 Al.pz-vbc.UPF
ATOMIC_POSITIONS crystal
 Al  0.3333333333333  0.6666666666667  0.0000000000
K_POINTS automatic
 8 8 8 0 0 0
