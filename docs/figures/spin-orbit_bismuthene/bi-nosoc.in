! Bismuthene, a honeycomb layer of bismuth, scalar-relativistic (no
! spin-orbit coupling). A small cutoff and a 6x6x1 mesh, enough for the bands.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 4, celldm(1) = 10.109950, celldm(3) = 1.978248,
    nat = 2, ntyp = 1,
    ecutwfc = 20.0, ecutrho = 160.0,
    occupations = 'smearing', smearing = 'gaussian', degauss = 0.01,
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Bi 208.98 Bi.pbe-dn-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS (crystal)
 Bi 0.333333333333 0.666666666667 0.0
 Bi 0.666666666667 0.333333333333 0.0
K_POINTS AUTOMATIC
 6 6 1 0 0 0
