! AlAs in the zincblende structure, ultrasoft PBE. Al and As are different
! atoms, so the Born charges are real charges of opposite sign.
! ecutrho is 8 times ecutwfc, because the augmentation charge is sharp.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.575, nat = 2, ntyp = 2,
    ecutwfc = 25.0, ecutrho = 200.0
 /
 &electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
 /
ATOMIC_SPECIES
 Al  26.98  Al.pbe-n-rrkjus_psl.1.0.0.UPF
 As  74.92  As.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS (alat)
 Al 0.00 0.00 0.00
 As 0.25 0.25 0.25
K_POINTS (automatic)
 4 4 4 1 1 1
