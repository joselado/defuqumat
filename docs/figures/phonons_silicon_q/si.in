! Silicon in the diamond structure, norm-conserving LDA. A phonon at q needs
! the whole k-mesh, so the symmetry is off (nosym, noinv) and the 4x4x4 mesh is
! unshifted, which is the mesh that keeps the symmetry of the crystal.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.20, nat = 2, ntyp = 1,
    ecutwfc = 18.0
    nosym = .true.
    noinv = .true.
 /
 &electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS (automatic)
 4 4 4 0 0 0
