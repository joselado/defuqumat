! Silicon in the diamond structure, LDA, norm-conserving. The forbidden (222)
! reflection is a small difference of two nearly equal atomic contributions,
! so it needs this cutoff and this k-mesh more than the total energy does.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.20, nat = 2, ntyp = 1,
    ecutwfc = 30.0,
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS {automatic}
 8 8 8 0 0 0
