! A chain of hydrogen atoms along z, two atoms per cell with opposite moments.
! The cell is doubled along z, so the charge repeats with half the period of
! the magnetization.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 6, celldm(1) = 12.0, celldm(3) = 0.83333333333333,
    nat = 2, ntyp = 2,
    ecutwfc = 25.0,
    occupations = 'smearing', smearing = 'gaussian', degauss = 0.10
    nspin = 2
    nosym = .true.
    starting_magnetization(1) =  0.6
    starting_magnetization(2) = -0.6
    nbnd = 12
 /
 &electrons
    mixing_beta = 0.3
    conv_thr = 1.0d-11
 /
ATOMIC_SPECIES
 H1  1.008  H.pz-vbc.UPF
 H2  1.008  H.pz-vbc.UPF
ATOMIC_POSITIONS (crystal)
 H1 0.0 0.0 0.0
 H2 0.0 0.0 0.5
K_POINTS {automatic}
 1 1 2 0 0 0
