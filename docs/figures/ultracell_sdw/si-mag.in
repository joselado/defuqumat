! The same silicon cell with two spin channels and a small smearing, so a
! magnetic field that changes from cell to cell can create a spin density wave.
! The cell converges with no moment of its own.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 2, celldm(1) = 10.20,
    nat = 2, ntyp = 1,
    ecutwfc = 12.0,
    nosym = .true., noinv = .true.,
    nspin = 2, starting_magnetization(1) = 0.2,
    occupations = 'smearing', smearing = 'gaussian', degauss = 0.02
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS automatic
 8 2 2 0 0 0
