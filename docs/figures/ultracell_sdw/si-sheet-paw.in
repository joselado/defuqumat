! A square silicon sheet in vacuum, PAW. The tip plane (0.85) and the exit
! plane (0.15) both lie outside the augmentation sphere of the atom at 0.5.
! One k-point along z, as a transmission through the sheet needs.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 6, celldm(1) = 5.5, celldm(3) = 2.5,
    nat = 1, ntyp = 1,
    ecutwfc = 20.0, ecutrho = 80.0,
    nosym = .true., noinv = .true., nbnd = 8,
    occupations = 'smearing', smearing = 'gaussian', degauss = 0.05
 /
 &electrons
    conv_thr = 1.0d-11
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-n-kjpaw_psl.0.1.UPF
ATOMIC_POSITIONS (crystal)
 Si 0.0 0.0 0.5
K_POINTS {automatic}
 4 4 1 0 0 0
