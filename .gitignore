__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
# QE reference tree: vendored, large, and read-only. Kept out of the repo.
quantum_espresso/
# scratch run outputs
out/
*.save/
# Session working files: the diagnostic harnesses a phase was debugged with,
# the handoff note, and the resumable regression summaries. None of them is a
# deliverable -- what a phase established goes in PLAN.md and in a test.
scratchpad/
notes/NEXT-SESSION.md
regression-results*/

# Generated by performance/run_performance.py -- one machine, one day.
performance/performance.tex
performance/performance.pdf
performance/performance.json
performance/*.aux
performance/*.log

# xelatex's build products for docs/features.tex. The PDF is committed
# (docs/features.pdf); these are regenerated by every build.
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.listing
performance/*.out

# Claude Code agent worktrees
.claude/worktrees/

# Machine- and site-specific working context: cluster access policy, account
# paths, private notes. Kept beside the checkout, never in a public repository.
*.local.md
regression-results/

# xelatex build products for slides/defuqumat.tex. The PDF is committed.
slides/*.aux
slides/*.log
slides/*.nav
slides/*.out
slides/*.snm
slides/*.toc

# The benchmark sweep's output: per-case JSON records and the report typeset
# from them. These describe one machine on one day (performance/sweep.py), and
# the generated sbatch array scripts describe one cluster account.
performance/results/
performance/cluster/generated/

# editor swap files
*.swp
*.swo
*~

# the logo run's saved density (62 MB, regenerable by tools/logo/compute.py scf on D22)
docs/logo/data/*.npz
docs/logo/mesh*/

# The user guide website and its PDF, built by mkdocs and docs/build_guide_pdf.py.
/site/
docs/user_guide.pdf

# User-guide figures: data.npz is committed, the run files are not.
docs/figures/.locks/
docs/figures/*/DONE
docs/figures/*/FAILED
docs/figures/*/RUNNING
docs/figures/*/compute.log
docs/figures/COMMIT
